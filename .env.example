NEXT_PUBLIC_SITE_URL=https://itshamid.com
# Replace with the final public HTTPS origin before a production build.
# Private/staging exports: true. Public production: false.
SEO_NOINDEX=false
# Optional real verification values (leave blank until supplied).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow public ownership key: 8–128 ASCII letters, digits or hyphens.
# The protocol publishes this key. Never use another service's secret here.
INDEXNOW_KEY=

# Contact page: public Web3Forms form identifier for hamidwork360@gmail.com.
# Create/verify the form and require hCaptcha in its Web3Forms settings.
# The owner-approved public key in data/contact-settings.ts is the default.
# Optional override; explicitly setting an empty value disables email sending.
# A new static build/redeploy is required after changing this value.
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Legacy agency/planner server path. Independent of the Web3Forms contact composer.
# Keep disabled until the verified inbox and providers are ready.
ENQUIRY_ENABLED=false
# Exact HTTPS origin, without a trailing slash. Loopback HTTP is for local previews.
ENQUIRY_ORIGIN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 random bytes encoded as 64 hexadecimal characters.
ENQUIRY_HMAC_SECRET=
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=
